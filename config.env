# ==============================================================================
# Configuration Settings for Raspberry Pi Setup
# Customize these values before running install.sh or export them as environment vars
# ==============================================================================

# Git Identity
GIT_USER_NAME="${GIT_USER_NAME:-your_username}"
GIT_USER_EMAIL="${GIT_USER_EMAIL:-your_email@example.com}"

# Node.js (via NVM)
NODE_VERSION="20"

# Ollama Local LLM & Vision Models
PULL_OLLAMA_MODELS=true
OLLAMA_MODELS=(
    "qwen2.5:1.5b"
    "moondream"
)

# Hardware & PCIe Settings
ENABLE_PCIE_GEN3=true

# Optional Components
INSTALL_DOCKER=true
GENERATE_CLOUDFLARE_HELPER=true
CREATE_WORKSPACE_DIRS=true
